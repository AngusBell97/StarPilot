Import('env')

# params.cc holds the whole keys table (637 keys in this build). clang at -O2 needs more memory for it than the
# comma has and the low-memory killer stops the build; -O0 needs ~270 MB and params access is file I/O bound anyway.
params_obj = env.Object('params.cc', CCFLAGS=[f for f in env['CCFLAGS'] if not str(f).startswith('-O')] + ['-O0'])

common_libs = [
  params_obj,
  'swaglog.cc',
  'util.cc',
  'ratekeeper.cc',
  'yuv.cc',
]

_common = env.Library('common', common_libs, LIBS="json11")
Export('_common')

params_python = env.SharedLibrary('params_c', 'params_c.cc', LIBS=[_common, 'json11'])
common_python = [params_python]
Export('common_python')

if GetOption('extras'):
  env.Program('tests/test_swaglog', 'tests/test_swaglog.cc', LIBS=[_common, 'json11', 'pthread'])

  env.Program('tests/bin/test_params_fork_lock', 'tests/test_params_fork_lock.cc',
              LIBS=[_common, 'json11', 'capnp', 'kj', 'pthread'])
